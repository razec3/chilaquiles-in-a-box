# Django
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must include the scheme and the port the app is reached on (the nginx
# entry point), e.g. http://localhost:8080 in local development.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# PostgreSQL
POSTGRES_DB=event_in_a_box
POSTGRES_USER=event_in_a_box
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
