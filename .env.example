# Django
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-me
DJANGO_DEBUG=True
# Comma-separated hostnames Django will serve. A leading dot matches any
# subdomain (e.g. .trycloudflare.com matches every random Cloudflare quick-
# tunnel hostname, such as random-words.trycloudflare.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# Origins the CSRF check trusts for unsafe (POST/PUT/...) requests. Must
# include the scheme and the port/host the app is reached on (the nginx
# entry point), e.g. http://localhost:8080 in local development. A leading
# "https://*." wildcard matches any subdomain, which covers Cloudflare quick
# tunnels' random per-run hostname.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.trycloudflare.com

# PostgreSQL
POSTGRES_DB=event_in_a_box
POSTGRES_USER=event_in_a_box
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
